<!-- Compiles the engine-free assemblies (Events, Runtime, Rules) outside Unity and runs quick checks.
     Lets cloud sessions (no Unity editor) verify their own work:  dotnet run, from Tools/CoreCheck -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion> <!-- Unity 6 compiles C# 9: don't use newer features in engine-free code -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Piglings/Scripts/Events/**/*.cs;../../Assets/_Piglings/Scripts/Runtime/**/*.cs;../../Assets/_Piglings/Scripts/Rules/**/*.cs" />
    <!-- One engine-free file from Simulation: the throw math. Compiling it here also guards that it stays free of UnityEngine. -->
    <Compile Include="../../Assets/_Piglings/Scripts/Simulation/ThrowSolver.cs" />
  </ItemGroup>
</Project>
